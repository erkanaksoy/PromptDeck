{
  "name": "promptdeck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-only attention dashboard for ChatGPT, Claude, and Gemini tabs.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs",
    "desktop:dev": "pnpm --filter @promptdeck/desktop exec tauri dev",
    "desktop:build": "pnpm --filter @promptdeck/desktop build",
    "desktop:test": "pnpm --filter @promptdeck/desktop test",
    "desktop:typecheck": "pnpm --filter @promptdeck/desktop typecheck",
    "desktop:lint": "pnpm --filter @promptdeck/desktop lint",
    "desktop:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-PromptDeckDesktop.ps1",
    "native-host:build": "cargo build --release -p promptdeck-native-host",
    "native-host:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Register-PromptDeckNativeHost.ps1",
    "native-host:unregister": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Register-PromptDeckNativeHost.ps1 -Unregister",
    "native-host:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Register-PromptDeckNativeHost.ps1 -Validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.1.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
